# ---------------------------------------------------------------------------
# Odoo Atlas — local development configuration
#
#   cp .env.example .env
#
# This file is committed. `.env` is not, and never should be (see .gitignore).
# Every value below is a DEVELOPMENT default. Production deployments must supply
# their own secrets through the platform's secret manager, never through a file.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
# Shared by Odoo and the Atlas engine. One cluster, two logical databases
# (ADR-0004): Odoo owns `odoo`, Alembic owns `atlas`.
POSTGRES_USER=odoo
# NOTE: this value is embedded in a libpq URL. Avoid @ : / ? # characters,
# or percent-encode them.
POSTGRES_PASSWORD=odoo_dev_password
POSTGRES_PORT=5432

ODOO_DB_NAME=odoo
ATLAS_DB_NAME=atlas

# --- Odoo ------------------------------------------------------------------
ODOO_PORT=8069

# Modules installed when the database is first created. Only applied on first
# boot: an existing database is left alone, and modules are installed from the
# Apps menu after that.
ODOO_INIT_MODULES=base,odoo_atlas

# The addon depends on `base` and `web` only. The business modules Atlas will
# index — sale, purchase, stock, account — are not dependencies of it, so their
# demo data is not installed by default. Add them to the list above when you
# want realistic customers, products, orders and invoices to develop ingestion
# against; that becomes the norm at M7.
ODOO_LOAD_DEMO_DATA=true

# --- Atlas engine ----------------------------------------------------------
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO

# Published on the loopback interface only. The engine must never be reachable
# from outside the compose network (ADR-0002, ADR-0006).
ATLAS_API_PORT=8000

# --- Model providers -------------------------------------------------------
# Anthropic ships no embedding API, so chat and embedding vendors are configured
# independently (ADR-0005).
#
# The defaults below are the OFFLINE providers, so `make up` works with no
# account and no spend. For a real deployment set:
#
#   ATLAS_CHAT__VENDOR=anthropic        ATLAS_CHAT__MODEL=claude-opus-5
#   ATLAS_EMBEDDING__VENDOR=openai      ATLAS_EMBEDDING__MODEL=text-embedding-3-small
#
# and supply the matching key. A missing key, an unpriced model, or a dimension
# that disagrees with the provider stops the engine at startup.
ATLAS_CHAT__VENDOR=fake
ATLAS_CHAT__MODEL=fake-model
ATLAS_EMBEDDING__VENDOR=hash
ATLAS_EMBEDDING__MODEL=hash-embedding-v1
ATLAS_EMBEDDING__DIMENSIONS=1536

# Read into ATLAS_CHAT__API_KEY / ATLAS_EMBEDDING__API_KEY by docker-compose.yml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Service-to-service authentication (wired up in M6) --------------------
# Shared secret the Odoo addon presents to the engine and vice versa.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ATLAS_SERVICE_TOKEN=
