<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Queues an incremental sync for every enabled source. It queues and
            returns: a full run takes minutes, and holding an Odoo cron thread
            open for all of them is the coupling ADR-0002 exists to avoid.

            Off by default. Nothing is indexed until somebody has chosen sources
            and, with them, decided to spend money on embeddings.
        -->
        <record id="ir_cron_atlas_sync" model="ir.cron">
            <field name="name">Atlas: index changed records</field>
            <field name="model_id" ref="model_atlas_ingest_source"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
